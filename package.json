{
  "name": "dilekce",
  "version": "0.1.0",
  "private": true,
  "description": "Dense, paper-style grid forms for shadcn/ui. Native controls, no headless library, one registry item. Pure TypeScript.",
  "keywords": [
    "forms",
    "grid",
    "gridforms",
    "react",
    "registry",
    "shadcn",
    "shadcn-ui",
    "tailwindcss"
  ],
  "homepage": "https://github.com/productdevbook/dilekce",
  "bugs": {
    "url": "https://github.com/productdevbook/dilekce/issues"
  },
  "license": "MIT",
  "author": "productdevbook",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/productdevbook/dilekce.git"
  },
  "funding": "https://github.com/sponsors/productdevbook",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "bun run registry:build && vite build",
    "preview": "vite preview",
    "registry:build": "shadcn build --output public/r",
    "lint": "oxlint . && oxfmt --check .",
    "lint:fix": "oxlint . --fix && oxfmt .",
    "fmt": "oxfmt .",
    "test": "bun run lint && bun run typecheck && vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/browser-playwright": "5.0.5",
    "oxfmt": "^0.73.0",
    "oxlint": "^1.88.0",
    "playwright": "1.64.1",
    "shadcn": "^4.22.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "5.0.5",
    "vitest-browser-react": "2.3.0"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "bun@1.4.3"
}
